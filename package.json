{
  "name": "@local/dsh-memory",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Keeps a verbatim archive of the conversation in the workspace and points the model at it, instead of letting compaction throw the original wording away.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "compaction",
    "archive"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "pack.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
