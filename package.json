{
  "name": "@local/dsh-memory",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Keeps a verbatim archive of the conversation in the workspace and tells the model exactly which folder is its own.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "pack.mjs", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
